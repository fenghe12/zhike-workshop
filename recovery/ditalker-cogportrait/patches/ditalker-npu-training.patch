diff --git a/metrics/calculate_mouth_landmark_distance.py b/metrics/calculate_mouth_landmark_distance.py
new file mode 100644
--- /dev/null
+++ b/metrics/calculate_mouth_landmark_distance.py
@@ -0,0 +1,32 @@
+"""Mean mouth landmark distance. This is not the SyncNet audio-visual metric."""
+
+from __future__ import annotations
+
+import argparse
+
+from metrics.common import LANDMARK_EXTS, load_landmarks, paired_files, save_result
+from metrics.landmark_distance import LIP_68, landmark_distance
+
+
+def parse_args() -> argparse.Namespace:
+    parser = argparse.ArgumentParser(description="Compute mean mouth landmark distance in input coordinate units.")
+    parser.add_argument("--gt_dir", required=True, help="Directory of GT landmark .npy/.json files.")
+    parser.add_argument("--generated_dir", required=True, help="Directory of generated landmark .npy/.json files.")
+    parser.add_argument("--output_json", default=None)
+    return parser.parse_args()
+
+
+def main() -> None:
+    args = parse_args()
+    scores = []
+    for gt_path, gen_path in paired_files(args.gt_dir, args.generated_dir, LANDMARK_EXTS):
+        score = landmark_distance(load_landmarks(gt_path), load_landmarks(gen_path), indices=LIP_68)
+        scores.append(score)
+        print(f"{gt_path.name}: {score:.6f}")
+    result = {"mouth_landmark_distance": float(sum(scores) / len(scores)), "num_pairs": len(scores)}
+    print(f"Mouth landmark distance: {result['mouth_landmark_distance']:.6f}")
+    save_result(args.output_json, result)
+
+
+if __name__ == "__main__":
+    main()
