{
  "source_repositories": {
    "SenseNova-U1.5": "https://github.com/OpenSenseNova/SenseNova-U1",
    "AgentHOI": "https://github.com/bone-11/agenthoi"
  },
  "models": [
    {
      "repository": "sensenova/SenseNova-U1.5-8B-MoT",
      "destination": "checkpoints/sensenova-u1.5-8b-mot",
