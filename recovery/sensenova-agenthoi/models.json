    {
      "repository": "OpenGVLab/InternVL3_5-38B",
      "destination": "checkpoints/internvl3_5-38b",
      "dtype": "BF16; official weights"
    }
  ],
  "existing_backbone": "checkpoints/wan2.1-i2v-14b",
  "private_obs_prefix": "npu-migration/runs/20261023-sensenova-agenthoi/",
  "sampling": "Keep official inputs and default sampling parameters. Only single-device placement, CPU offload and NPU compatibility are configured."
}
