<view class="page results-page">
  <view class="results-heading">
    <view class="eyebrow">GENERATED OUTPUTS</view>
    <view class="results-title">结果中心</view>
    <view class="results-copy">预览并下载已完成任务的课程视频和 SRT 字幕。</view>
  </view>

  <view wx:if="{{loading}}" class="surface result-loading">
    <view></view><view></view><view></view>
  </view>

  <view wx:elif="{{tasks.length}}" class="result-list">
    <view wx:for="{{tasks}}" wx:key="id" class="surface result-card">
      <view class="result-preview" data-id="{{item.id}}" bindtap="openResult">
        <image class="result-preview-image" src="{{item.video.previewImage}}" mode="aspectFill"></image>
        <view class="preview-play">▶</view>
        <view class="preview-duration">{{item.video.duration}}</view>
      </view>

      <view class="result-main">
        <view class="result-top">
          <view class="result-name">{{item.name}}</view>
          <text class="tag tag-success">已完成</text>
        </view>
        <view class="result-languages">
          <text wx:for="{{item.targetLanguages}}" wx:key="*this">{{item}}</text>
        </view>
        <view class="result-meta">
          <text>{{item.video.resolution}}</text><view></view><text>{{item.video.frameRate}}</text><view></view><text>{{item.video.subtitleCount}} 条字幕</text>
        </view>
        <view class="result-time">完成时间：{{item.completedLabel}}</view>
      </view>

      <view class="hairline"></view>
      <view class="result-actions">
        <button class="detail-action" data-id="{{item.id}}" bindtap="openTask">任务详情</button>
        <button class="subtitle-action" data-id="{{item.id}}" bindtap="exportSubtitle">下载 SRT</button>
        <button class="video-action" data-id="{{item.id}}" bindtap="openResult">视频与文件</button>
      </view>
    </view>
  </view>

  <view wx:else class="surface empty-state">
    <view class="empty-mark">影</view>
    <view class="empty-title">暂无已完成结果</view>
    <view class="empty-copy">课程视频完成合成后，将在此显示预览和下载入口。</view>
  </view>
</view>
