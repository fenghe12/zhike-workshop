.avatar-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 11rpx;
}

.avatar-metric-card {
  padding: 22rpx 8rpx;
  text-align: center;
}

.avatar-metric-card text {
  color: #176b5b;
  font-size: 28rpx;
  font-weight: 740;
}

.avatar-metric-card view {
  margin-top: 6rpx;
  color: #8b9499;
  font-size: 19rpx;
}

.feature-flow-list {
  margin-top: 15rpx;
  padding: 9rpx 22rpx;
}

.feature-flow-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #edf0f1;
}

.feature-flow-item:last-child { border-bottom: 0; }

.feature-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  border-radius: 11rpx;
  color: #176b5b;
  background: #e5f2ee;
  font-size: 18rpx;
  font-weight: 700;
}

.feature-title {
  color: #39454b;
  font-size: 23rpx;
  font-weight: 650;
}

.feature-detail {
  margin-top: 5rpx;
  color: #879095;
  font-size: 20rpx;
  line-height: 1.45;
}

.segment-list {
  padding: 6rpx 22rpx;
}

.segment-item {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  border-bottom: 1rpx solid #edf0f1;
}

.segment-item:last-child { border-bottom: 0; }

.segment-play {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  color: #176b5b;
  background: #e5f2ee;
  font-size: 18rpx;
}

.segment-main {
  min-width: 0;
  flex: 1;
  margin-left: 15rpx;
}

.segment-id {
  color: #465158;
  font-size: 20rpx;
}

.segment-meta {
  margin-top: 5rpx;
  color: #899297;
  font-size: 19rpx;
}

.segment-status {
  color: #176b5b;
  font-size: 20rpx;
}

.video-preview {
  position: relative;
  min-height: 376rpx;
  margin-top: 27rpx;
  overflow: hidden;
  border: 0;
  color: #ffffff;
  background: linear-gradient(135deg, #172228, #28464b);
}

.video-preview-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.video-avatar-overlay {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  z-index: 2;
  width: 146rpx;
  height: 166rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 12rpx;
  background: #d7e7e2;
  box-shadow: 0 5rpx 16rpx rgba(18, 39, 41, 0.3);
}

.video-play-button {
  position: absolute;
  top: 152rpx;
  left: 316rpx;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.55);
  border-radius: 50%;
  color: #ffffff;
  background: rgba(13, 29, 31, 0.58);
  font-size: 25rpx;
  text-indent: 4rpx;
  backdrop-filter: blur(5rpx);
}

.video-subtitle {
  position: absolute;
  right: 176rpx;
  bottom: 19rpx;
  left: 40rpx;
  overflow: hidden;
  color: #ffffff;
  font-size: 19rpx;
  text-align: center;
  text-overflow: ellipsis;
  text-shadow: 0 2rpx 5rpx rgba(0, 0, 0, 0.65);
  white-space: nowrap;
}

.video-time {
  position: absolute;
  right: 18rpx;
  bottom: 14rpx;
  z-index: 4;
  padding: 5rpx 8rpx;
  border-radius: 6rpx;
  color: #ffffff;
  background: rgba(0, 0, 0, 0.5);
  font-size: 17rpx;
}

.video-title-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 15rpx;
  padding: 18rpx 5rpx 0;
}

.result-video-name {
  color: #303c42;
  font-size: 27rpx;
  font-weight: 690;
}

.result-video-meta {
  margin-top: 6rpx;
  color: #8b9498;
  font-size: 20rpx;
}

.track-list {
  padding: 9rpx 20rpx;
}

.track-item {
  display: flex;
  align-items: center;
  min-height: 84rpx;
  border-bottom: 1rpx solid #edf0f1;
}

.track-item:last-child { border-bottom: 0; }

.track-color {
  width: 10rpx;
  height: 46rpx;
  margin-right: 14rpx;
  border-radius: 5rpx;
}

.track-green { background: #4c9a86; }
.track-blue { background: #4d7fa8; }
.track-amber { background: #c8943e; }
.track-purple { background: #796ca1; }

.track-main {
  width: 185rpx;
}

.track-main view {
  color: #3d494f;
  font-size: 22rpx;
  font-weight: 650;
}

.track-main text {
  display: block;
  margin-top: 4rpx;
  color: #8b9499;
  font-size: 17rpx;
}

.track-blocks {
  display: flex;
  flex: 1;
  gap: 5rpx;
}

.track-blocks view {
  flex: 1;
  height: 24rpx;
  border-radius: 5rpx;
  background: #dce5e3;
}

.track-blocks view:nth-child(2) { flex: 1.5; }
.track-blocks view:nth-child(3) { flex: 0.7; }

.encoding-card {
  margin-top: 15rpx;
  padding: 5rpx 23rpx;
}

.encoding-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
  color: #7e878c;
  font-size: 21rpx;
}

.encoding-item text:last-child {
  color: #3e4a50;
  font-weight: 620;
}

.subtitle-list {
  padding: 7rpx 22rpx;
}

.subtitle-item {
  display: flex;
  align-items: flex-start;
  gap: 15rpx;
  padding: 17rpx 0;
  border-bottom: 1rpx solid #edf0f1;
}

.subtitle-item:last-child { border-bottom: 0; }

.subtitle-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 auto;
  width: 38rpx;
  height: 38rpx;
  border-radius: 11rpx;
  color: #176b5b;
  background: #e5f2ee;
  font-size: 18rpx;
  font-weight: 700;
}

.subtitle-time {
  color: #7e888d;
  font-size: 18rpx;
}

.subtitle-text {
  margin-top: 7rpx;
  color: #465158;
  font-size: 22rpx;
  line-height: 1.5;
}

.output-file-list {
  padding: 5rpx 22rpx;
}

.output-file-item {
  display: flex;
  align-items: center;
  min-height: 94rpx;
  border-bottom: 1rpx solid #edf0f1;
}

.output-file-item:last-child { border-bottom: 0; }

.output-file-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 14rpx;
  color: #176b5b;
  background: #e6f2ee;
  font-family: "SFMono-Regular", Consolas, monospace;
  font-size: 16rpx;
  font-weight: 760;
}

.output-file-main {
  min-width: 0;
  flex: 1;
  margin-left: 15rpx;
}

.output-file-main view {
  overflow: hidden;
  color: #3d494f;
  font-size: 23rpx;
  font-weight: 630;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.output-file-main text {
  display: block;
  margin-top: 5rpx;
  color: #8b9499;
  font-size: 19rpx;
}

.output-download {
  padding-left: 14rpx;
  color: #176b5b;
  font-size: 21rpx;
  font-weight: 650;
}

.retry-card {
  display: flex;
  align-items: center;
  gap: 18rpx;
  margin-top: 20rpx;
  padding: 22rpx;
  border-color: #f0cece;
  background: #fff7f7;
}

.retry-card > view {
  flex: 1;
}

.retry-card button {
  flex: 0 0 180rpx;
  margin: 0;
}

.retry-title {
  color: #873d3d;
  font-size: 23rpx;
  font-weight: 680;
}

.retry-copy {
  margin-top: 4rpx;
  color: #a17272;
  font-size: 20rpx;
}

.stage-navigation {
  margin-top: 30rpx;
}

.nav-disabled {
  opacity: 0.45;
}
