  border-radius: 8rpx;
  color: #176b5b;
  background: rgba(229, 242, 238, 0.94);
  font-size: 16rpx;
}

.placement-info {
  margin-top: 15rpx;
  padding: 22rpx 24rpx;
}

.placement-main {
