  align-items: center;
  justify-content: space-between;
}

.placement-label {
  color: #7b858a;
  font-size: 22rpx;
}

.placement-value {
  color: #176b5b;
  font-size: 25rpx;
  font-weight: 680;
}

.bbox-values {
  margin-top: 13rpx;
  padding: 12rpx 14rpx;
  border-radius: 9rpx;
  color: #546068;
  background: #f1f4f5;
  font-size: 18rpx;
}

.placement-reason {
  margin-top: 12rpx;
  color: #798489;
  font-size: 21rpx;
  line-height: 1.55;
}

.region-list {
  padding: 6rpx 22rpx;
}

.region-item {
  display: flex;
  align-items: center;
  min-height: 80rpx;
  border-bottom: 1rpx solid #edf0f1;
  color: #667177;
  font-size: 21rpx;
}

.region-item:last-child { border-bottom: 0; }

.region-indicator {
  width: 12rpx;
