<view class="page home-page">
  <view class="welcome-row">
    <view>
      <view class="eyebrow">MOOC PRODUCTION DESK</view>
      <view class="welcome-title">{{user.name || '课程管理员'}}，欢迎使用</view>
      <view class="welcome-copy">{{user.institution || '多语种课程制作中心'}}</view>
    </view>
    <view class="avatar-badge">{{user.avatarInitial || '智'}}</view>
  </view>

  <view class="hero-card surface">
    <view class="hero-grid"></view>
    <view class="hero-content">
      <view class="hero-label">从课程素材到多语种视频</view>
      <view class="hero-title">多智能体协同驱动<br />S1—S5 自动生成流程</view>
      <view class="hero-meta">
        <text>中文</text><text>英语</text><text>日语</text><text>韩语</text><text>德语</text><text>法语</text>
      </view>
      <button class="hero-button" bindtap="createTask">新建生成任务</button>
    </view>
    <view class="hero-orbit">
      <view class="orbit-ring orbit-ring-a"></view>
      <view class="orbit-ring orbit-ring-b"></view>
      <view class="orbit-core">AI</view>
      <view class="orbit-node node-one">课</view>
      <view class="orbit-node node-two">译</view>
      <view class="orbit-node node-three">声</view>
      <view class="orbit-node node-four">人</view>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-card surface">
      <text class="stat-value">{{stats.total}}</text>
      <text class="stat-label">全部任务</text>
    </view>
    <view class="stat-card surface">
      <text class="stat-value accent">{{stats.processing}}</text>
      <text class="stat-label">正在生成</text>
    </view>
    <view class="stat-card surface">
      <text class="stat-value">{{stats.completed}}</text>
      <text class="stat-label">已完成</text>
    </view>
    <view class="stat-card surface">
      <text class="stat-value">{{stats.languages}}</text>
      <text class="stat-label">目标语种</text>
    </view>
  </view>

  <view class="section-heading">
    <view>
      <view class="section-title">生成任务</view>
      <view class="section-note">查看全流程状态与阶段结果</view>
    </view>
    <text class="link-text" bindtap="openAgents">智能体说明</text>
  </view>

  <scroll-view class="filter-scroll" scroll-x="true" enhanced="true" show-scrollbar="false">
    <view class="filter-row">
      <view wx:for="{{filters}}" wx:key="key" class="filter-chip {{activeFilter === item.key ? 'filter-active' : ''}}" data-key="{{item.key}}" bindtap="changeFilter">
        {{item.label}}
      </view>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading-card surface">
    <view class="loading-bar loading-long"></view>
    <view class="loading-bar loading-medium"></view>
    <view class="loading-bar loading-short"></view>
  </view>

  <view wx:elif="{{tasks.length}}" class="task-list">
    <view wx:for="{{tasks}}" wx:key="id" class="task-card surface" data-id="{{item.id}}" bindtap="openTask">
      <view class="task-top">
        <view class="task-mode-icon {{item.mode === 'topic' ? 'topic-mode' : 'upload-mode'}}">{{item.mode === 'topic' ? '题' : '件'}}</view>
        <view class="task-heading">
          <view class="task-name">{{item.name}}</view>
          <view class="task-mode">{{item.modeLabel}} · {{item.sourceLanguage}} → {{item.languageCount}} 个语种</view>
        </view>
        <view class="status-pill {{item.statusClass}}">{{item.statusLabel}}</view>
      </view>

      <view class="language-row">
        <text wx:for="{{item.targetLanguages}}" wx:key="*this" class="language-tag">{{item}}</text>
      </view>

      <view class="task-progress-head">
        <text>{{item.activeStageTitle}}</text>
        <text class="progress-number">{{item.overallProgress}}%</text>
      </view>
      <view class="progress-track">
        <view class="progress-fill {{item.status === 'failed' ? 'progress-error' : ''}}" style="width: {{item.overallProgress}}%;"></view>
      </view>
      <view class="task-footer">
        <text>{{item.updatedLabel}}</text>
        <text class="task-arrow">查看详情 ›</text>
      </view>
    </view>
  </view>

  <view wx:else class="surface empty-state">
    <view class="empty-mark">+</view>
    <view class="empty-title">暂无相关任务</view>
    <view class="empty-copy">新建任务后，可在此查看四个智能体及五个阶段的处理状态。</view>
  </view>
</view>
