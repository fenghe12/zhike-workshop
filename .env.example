# Copy to .env. Use an existing, writable persistent location.
SMARTCOURSE_RUNTIME_ROOT=$PWD/.runtime
SMARTCOURSE_GATEWAY_URL=http://127.0.0.1:17813/v1/chat/completions
SMARTCOURSE_GATEWAY_MODEL=Qwen3.6-35B-A3B
SMARTCOURSE_PPT_GENERATOR=qwen
KIMI_API_KEY=local-npu
SMARTCOURSE_REMOTE_MEDIA=1
SMARTCOURSE_MEDIA_SERVICE_ENABLED=1
SMARTCOURSE_TRANSLATION_WORKERS=1
# Simultaneous course pipelines: normally 3, maximum 5. Media stages share one slot.
SMARTCOURSE_TASK_WORKERS=3
# Enable separate speech/avatar slots only after checking combined device memory.
SMARTCOURSE_MEDIA_OVERLAP=0
SMARTCOURSE_REMOTE_STATE=$SMARTCOURSE_RUNTIME_ROOT/remote-state.json
SMARTCOURSE_SSH_KEY=$HOME/.ssh/id_rsa
SMARTCOURSE_SSH_KNOWN_HOSTS=$HOME/.ssh/known_hosts
SMARTCOURSE_REMOTE_ROOT=/home/ma-user/work/smartcourse
SMARTCOURSE_REMOTE_NPU_ROOT=/home/ma-user/work/npu-migration
SMARTCOURSE_DEFAULT_REFERENCE_AUDIO=$SMARTCOURSE_RUNTIME_ROOT/references/voice.wav
SMARTCOURSE_DEFAULT_REFERENCE_IMAGE=$SMARTCOURSE_RUNTIME_ROOT/references/teacher.png
SMARTCOURSE_WHISPER_MODEL_PATH=$SMARTCOURSE_RUNTIME_ROOT/models/whisper-small
SMARTCOURSE_CJK_FONT=$SMARTCOURSE_RUNTIME_ROOT/fonts/NotoSansCJK-Regular.ttc
SMARTCOURSE_FONT_ROOT=$SMARTCOURSE_RUNTIME_ROOT/fonts
SMARTCOURSE_EMBED_FONT_REGULAR=$SMARTCOURSE_FONT_ROOT/SmartCourseJP-Regular.ttf
SMARTCOURSE_EMBED_FONT_BOLD=$SMARTCOURSE_FONT_ROOT/SmartCourseJP-Bold.ttf
SMARTCOURSE_FONT_LICENSE=$SMARTCOURSE_FONT_ROOT/NotoSansJP-OFL.txt
SMARTCOURSE_TTS_SPEED=1.0
# Render caption images once and let FFmpeg overlay them. Retain python only for comparison.
SMARTCOURSE_CAPTION_RENDERER=ffmpeg
SMARTCOURSE_COMPOSE_THREADS=2
# Optional: FFmpeg executable in the remote persistent media environment.
SMARTCOURSE_REMOTE_FFMPEG=
# Set SMARTCOURSE_SOFFICE to your persistent LibreOffice executable if absent from PATH.
# Set OBS_BUCKET and OBS_CREDENTIALS_FILE only for private OBS restoration.
OBS_BUCKET=
OBS_ENDPOINT=https://obs.cn-southwest-2.myhuaweicloud.com
OBS_CREDENTIALS_FILE=

# Optional email delivery. Keep the SMTP password in a private persistent file.
SMARTCOURSE_SMTP_HOST=
SMARTCOURSE_SMTP_PORT=465
SMARTCOURSE_SMTP_SECURITY=ssl
SMARTCOURSE_SMTP_FROM=
SMARTCOURSE_SMTP_USER=
SMARTCOURSE_SMTP_PASSWORD_FILE=
# With SMTP enabled, new accounts must verify an email address.
# Cloud account credentials belong on the controller, never in the web service.
SMARTCOURSE_CONTROL_TOKEN_FILE=
SMARTCOURSE_COMPUTE_HOURLY_CNY=18.682
