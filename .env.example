# Copy to .env. Use an existing, writable persistent location.
SMARTCOURSE_RUNTIME_ROOT=$PWD/.runtime
SMARTCOURSE_GATEWAY_URL=http://127.0.0.1:17813/v1/chat/completions
SMARTCOURSE_GATEWAY_MODEL=Qwen3.6-35B-A3B
KIMI_API_KEY=local-npu
SMARTCOURSE_REMOTE_MEDIA=1
SMARTCOURSE_REMOTE_STATE=$SMARTCOURSE_RUNTIME_ROOT/remote-state.json
SMARTCOURSE_SSH_KEY=$HOME/.ssh/id_rsa
SMARTCOURSE_SSH_KNOWN_HOSTS=$HOME/.ssh/known_hosts
SMARTCOURSE_REMOTE_ROOT=/home/ma-user/work/smartcourse
SMARTCOURSE_REMOTE_NPU_ROOT=/home/ma-user/work/npu-migration
SMARTCOURSE_DEFAULT_REFERENCE_AUDIO=$SMARTCOURSE_RUNTIME_ROOT/references/voice.wav
SMARTCOURSE_DEFAULT_REFERENCE_IMAGE=$SMARTCOURSE_RUNTIME_ROOT/references/teacher.png
SMARTCOURSE_WHISPER_MODEL_PATH=$SMARTCOURSE_RUNTIME_ROOT/models/whisper-small
SMARTCOURSE_CJK_FONT=$SMARTCOURSE_RUNTIME_ROOT/fonts/NotoSansCJK-Regular.ttc
# Set SMARTCOURSE_SOFFICE to your persistent LibreOffice executable if absent from PATH.
# Set OBS_BUCKET and OBS_CREDENTIALS_FILE only for private OBS restoration.
OBS_BUCKET=
OBS_ENDPOINT=https://obs.cn-southwest-2.myhuaweicloud.com
OBS_CREDENTIALS_FILE=
